    field(TWSV, "MAJOR")
    field(THSV, "MINOR")
    field(FRSV, "MINOR")
    field(FVSV, "MINOR")
    field(SXSV, "MINOR")
    field(SVSV, "MAJOR")
    field(EISV, "MINOR")
    field(NISV, "MINOR")
    field(TESV, "MINOR")
    field(ELSV, "MAJOR")
    field(TVSV, "MINOR")
    field(TTSV, "MINOR")
    field(FTSV, "MINOR")
    field(FFSV, "MAJOR")
    info(Q:STATE0_AMSG,  "State 0 alarm")
    info(Q:STATE1_AMSG,  "State 1 alarm")
    info(Q:STATE2_AMSG,  "State 2 alarm")
    info(Q:STATE3_AMSG,  "State 3 alarm")
    info(Q:STATE4_AMSG,  "State 4 alarm")
    info(Q:STATE5_AMSG,  "State 5 alarm")
