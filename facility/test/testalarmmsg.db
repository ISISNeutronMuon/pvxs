record(ai, "test:amsg") {
    field(HHSV, "MAJOR")
    field(HSV,  "MINOR")
    field(LSV,  "MINOR")
    field(LLSV, "MAJOR")
    field(HIHI, "90")
    field(HIGH, "80")
    field(LOW,  "20")
    field(LOLO, "10")
    field(HOPR, "100")
    info(Q:HIHI_AMSG,    "Too high!")
    info(Q:HIGH_AMSG,    "Getting high")
    info(Q:LOLO_AMSG,    "Value is critically low - this message exceeds forty chars")
    info(Q:DEFAULT_AMSG, "Something is wrong")
}
record(ai, "test:amsg:default") {
    field(HHSV, "MAJOR")
    field(HSV,  "MINOR")
    field(HIHI, "90")
    field(HIGH, "80")
    field(HOPR, "100")
    info(Q:DEFAULT_AMSG, "Default message")
}
record(mbbi, "test:amsg:state") {
    field(ZRST, "Zero")
    field(ONST, "One")
    field(TWST, "Two")
    field(THST, "Three")
    field(FRST, "Four")
    field(FVST, "Five")
    field(SXST, "Six")
    field(SVST, "Seven")
    field(EIST, "Eight")
    field(NIST, "Nine")
    field(TEST, "Ten")
    field(ELST, "Eleven")
    field(TVST, "Twelve")
    field(TTST, "Thirteen")
    field(FTST, "Fourteen")
    field(FFST, "Fifteen")
    field(ZRSV, "MINOR")
    field(ONSV, "MINOR")
    field(TWSV, "MAJOR")
    field(THSV, "MINOR")
    field(FRSV, "MINOR")
    field(FVSV, "MINOR")
    field(SXSV, "MINOR")
    field(SVSV, "MAJOR")
    field(EISV, "MINOR")
    field(NISV, "MINOR")
    field(TESV, "MINOR")
    field(ELSV, "MAJOR")
    field(TVSV, "MINOR")
    field(TTSV, "MINOR")
    field(FTSV, "MINOR")
    field(FFSV, "MAJOR")
    info(Q:STATE0_AMSG,  "State 0 alarm")
    info(Q:STATE1_AMSG,  "State 1 alarm")
    info(Q:STATE2_AMSG,  "State 2 alarm")
    info(Q:STATE3_AMSG,  "State 3 alarm")
    info(Q:STATE4_AMSG,  "State 4 alarm")
    info(Q:STATE5_AMSG,  "State 5 alarm")
    info(Q:STATE6_AMSG,  "State 6 alarm")
    info(Q:STATE7_AMSG,  "State 7 alarm")
    info(Q:STATE8_AMSG,  "State 8 alarm")
    info(Q:STATE9_AMSG,  "State 9 alarm")
    info(Q:STATE10_AMSG, "State 10 alarm")
    info(Q:STATE11_AMSG, "State 11 alarm")
    info(Q:STATE12_AMSG, "State 12 alarm")
    info(Q:STATE13_AMSG, "State 13 alarm")
    info(Q:STATE14_AMSG, "State 14 alarm")
    info(Q:STATE15_AMSG, "State 15 alarm")
}
